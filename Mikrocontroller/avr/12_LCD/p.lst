 314:p.c           **** 		else print_single_character('+');
 315:p.c           **** 		print_string("inf");
 316:p.c           **** 		return;
 317:p.c           **** 	}
 318:p.c           **** 	// Not a number
 319:p.c           **** 	else if(e == 255 && f != 0)
 320:p.c           **** 	{
 321:p.c           **** 		print_string("NaN");
 322:p.c           **** 		return;
 323:p.c           **** 	}
 324:p.c           **** 	// Denormalisierte Zahlen werden nicht unterstützt,
 325:p.c           **** 	// da so viele Nuller auf dem Display nicht darstellbar sind
 326:p.c           **** 	else if(e == 0 && f != 0)
 327:p.c           **** 	{
