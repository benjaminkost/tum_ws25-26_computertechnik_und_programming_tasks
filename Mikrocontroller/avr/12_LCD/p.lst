 296:p.c           **** 	sign = bits >> 31;					// Bit 31 ist Vorzeichen
 307               		.loc 1 296 2 view .LVU51
 297:p.c           **** 	e = ((bits << 1) >> 24);			// Bits 30..23 nach 7..0 schieben
 308               		.loc 1 297 2 view .LVU52
 298:p.c           **** 	exp = e - 127;						// Exponent: exp = e - K (127)
 309               		.loc 1 298 2 view .LVU53
 299:p.c           **** 	f = bits & 0x7FFFFF;				// f (fraction) aus 1.f
 310               		.loc 1 299 2 view .LVU54
