 341:p.c           **** 		nachkomma = ( m << (31 - (22 - exp)) ) >> (31 - (22 - exp));
 342:p.c           **** 
 343:p.c           **** 		// '-', Vorkomma-Stellen und ',' ausgeben
 344:p.c           **** 		if(sign) print_single_character('-');
 345:p.c           **** 		print_integer(vorkomma);
 346:p.c           **** 		print_single_character(',');
 347:p.c           **** 
 348:p.c           **** 		// Nachkommastellen ausgeben
 349:p.c           **** 		// Bits pro Dezimalstelle: log_10(10) / log_10(2) = 3,3219
 350:p.c           **** 		rounds = ((23 - exp) / 3.32) + 0.5;
 351:p.c           **** 		for( ; rounds > 0; rounds--)
 352:p.c           **** 		{
 353:p.c           **** 			nachkomma *= 10;
 354:p.c           **** 			d = (nachkomma >> (23-exp)) % 10;	// auszugebende Ziffer
 355:p.c           **** 			print_single_character(d + '0');	// als Zeichen ausgeben
 356:p.c           **** 		}
 357:p.c           **** 	}
 358:p.c           **** 
 359:p.c           **** 	// Zahl nach rechts (Komma nach links) schieben
 360:p.c           **** 	else
 361:p.c           **** 	{
 362:p.c           **** 		if(sign) print_single_character('-');
 363:p.c           **** 		print_single_character('0');
 364:p.c           **** 		print_single_character(',');
 365:p.c           **** 
 366:p.c           **** 		nachkomma = m;
 367:p.c           **** 
 368:p.c           **** 		rounds = ((23 - exp) / 3.32) + 0.5;
 369:p.c           **** 		for( ; rounds > 0; rounds--)
 370:p.c           **** 		{
 371:p.c           **** 			nachkomma *= 10;
